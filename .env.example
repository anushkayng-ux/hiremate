# Copy to .env for local runs. On Hugging Face Spaces, add these under Settings → Variables and secrets.
# Never commit real keys.

# --- AI writing model: auto | gemini | claude | ollama | template
LLM_PROVIDER=auto
GEMINI_API_KEY=            # free key from Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=         # optional
CLAUDE_MODEL=claude-haiku-5-5
OLLAMA_URL=http://localhost:11434   # offline option: ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Search
EMBEDDER=auto              # auto | bge | hashing
VECTOR_STORE=auto          # auto | chroma | memory

# --- Security
JWT_SECRET=replace-with-a-long-random-string
DEMO_PASSWORD=recruit123

# --- Frontend → backend
API_URL=http://127.0.0.1:8000

# Optional: also send real emails (candidate portal always gets them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
